# Never expose this as a VITE_ variable. Start with Stripe TEST credentials.
STRIPE_SECRET_KEY=
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
# Set true only after adding the real STL files, reviewing the catalogue,
# and publishing the seller identity and complete sales/privacy terms.
COMMERCE_ENABLED=false
# Optional absolute path; default is ./private-files. Never use public/ or dist/.
# FILES_DIR=/absolute/path/to/private-files

# Required for signed Stripe TEST webhooks at /api/stripe/webhook.
# Only sk_test_ keys and livemode=false events are accepted by this implementation.
STRIPE_WEBHOOK_SECRET=
# Optional absolute persistent directory (SQLite + immutable purchased file versions).
# DATA_DIR=/absolute/private/path/moya-data
# Emails stay queued unless explicitly enabled. Never use a public client/VITE_ key.
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Run worker explicitly: node scripts/commerce.mjs emails
# Run reconciliation: node scripts/commerce.mjs reconcile
